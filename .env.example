# ==========================================
# SMART CMMS - ENVIRONMENT CONFIGURATION
# ==========================================

# --- APPLICATION ENVIRONMENT ---
NODE_ENV=development
APP_PORT=3000
API_PREFIX=api/v1

# --- DATABASE (POSTGRESQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=smart_cmms_db
DB_SYNCHRONIZE=true
DB_LOGGING=false

# --- REDIS (OPTIONAL CACHE/QUEUE) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- SECURITY & AUTHENTICATION ---
JWT_SECRET=super_secret_smart_cmms_jwt_key_2026
JWT_EXPIRATION=86400s

# --- FRONTEND CLIENT ---
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:3000/api/v1

# --- SEED SETTINGS ---
SEED_ASSET_COUNT=300
SEED_WORK_ORDER_COUNT=1000
